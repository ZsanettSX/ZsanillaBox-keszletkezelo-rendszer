# ── Adatbázis ────────────────────────────────────────────────────────────────
# Helyi fejlesztéshez (npm run db:local indítja a beágyazott Postgres-t).
# A pgbouncer=true itt kötelező: a helyi szerver egy motoron osztozik a kapcsolatok
# között, ezért a Prisma prepared statementjei ütköznének nélküle.
#   postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&pgbouncer=true&connection_limit=1
#
# Vercelen (Neon): a POOLED kapcsolat, a "-pooler" végű hosttal. A szerver nélküli
# függvények minden hívásnál új kapcsolatot nyitnának, ezt fogja össze a pooler.
DATABASE_URL="postgresql://user:jelszo@ep-xyz-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# Közvetlen (pooler nélküli) kapcsolat — csak a migrációk használják.
# Neonnál ugyanaz a cím, de a hostból hiányzik a "-pooler".
DIRECT_URL="postgresql://user:jelszo@ep-xyz.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── Shopify ──────────────────────────────────────────────────────────────────
# A bolt domainje, pl. zsanillabox.myshopify.com
SHOPIFY_SHOP_DOMAIN=""
# Custom app Admin API access token (shpat_...) — a webhook regisztrációhoz és exporthoz kell
SHOPIFY_ADMIN_ACCESS_TOKEN=""
# A custom app "API secret key"-e — EZZEL ellenőrizzük a bejövő webhookok HMAC aláírását
SHOPIFY_WEBHOOK_SECRET=""
# Opcionális: a Shopify API verziója a webhook-regisztrációhoz. Üresen a script
# alapértelmezését használja; állítsd az app "Webhooks API version" mezőjéhez.
SHOPIFY_API_VERSION=""

# ── Email riasztás (Resend) ──────────────────────────────────────────────────
RESEND_API_KEY=""
# Feladó cím. Amíg nincs saját hitelesített domain, használható: onboarding@resend.dev
ALERT_EMAIL_FROM="ZsanillaBox Készlet <onboarding@resend.dev>"
# Címzett(ek), vesszővel elválasztva
ALERT_EMAIL_TO="sajtizsanett@gmail.com"

# ── Cron / admin védelem ─────────────────────────────────────────────────────
# Hosszú véletlen string. A /api/cron/daily endpoint csak ezzel hívható.
CRON_SECRET=""

# Az admin felület jelszava (HTTP Basic auth). Üresen hagyva nincs védelem (csak helyi fejlesztéshez!).
ADMIN_PASSWORD=""

# A rendszer publikus URL-je (a webhook regisztrációhoz), pl. https://keszlet.up.railway.app
APP_URL="http://localhost:3000"
